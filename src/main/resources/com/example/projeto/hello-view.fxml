<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.projeto.HelloController"
            prefHeight="600.0" prefWidth="800.0">
    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="DoaFácil - Sistema de Doações Comunitárias" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <HBox spacing="10">
                <Button text="Doadores" onAction="#showDoador" prefWidth="150"/>
                <Button text="Instituições" onAction="#showEntidade" prefWidth="150"/>
                <Button text="Doações" onAction="#showDoacao" prefWidth="150"/>
                <Button text="Listar Doações" onAction="#showDoacaoLista" prefWidth="150"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="contentArea">
            <Label text="Bem-vindo ao Sistema de Doações Comunitárias" style="-fx-font-size: 18px;"/>
        </StackPane>
    </center>
</BorderPane>