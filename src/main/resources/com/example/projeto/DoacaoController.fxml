<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.projeto.DoacaoController"
      spacing="10" alignment="TOP_CENTER">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Cadastro de Doações" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="100" prefWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="200" prefWidth="300"/>
        </columnConstraints>

        <Label text="Doador:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="doadoComboBox" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"/>

        <Label text="Instituição:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="entidadeComboBox" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="300"/>

        <Label text="Item:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="itemField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Quantidade:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="quantityField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Data:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="300"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Salvar" onAction="#handleSave"/>
    </HBox>

    <TableView fx:id="doacaoTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="doadorColumn" text="Doador" prefWidth="150"/>
            <TableColumn fx:id="entidadeColumn" text="Instituição" prefWidth="150"/>
            <TableColumn fx:id="itemColumn" text="Item" prefWidth="150"/>
            <TableColumn fx:id="quantityColumn" text="Quantidade" prefWidth="100"/>
            <TableColumn fx:id="dateColumn" text="Data" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER">
    </HBox>
</VBox>