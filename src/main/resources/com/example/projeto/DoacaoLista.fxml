<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.projeto.DoacaoController"
      spacing="10" alignment="TOP_CENTER">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Listagem de Doações" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Filtrar por:"/>
        <ComboBox fx:id="filterTypeComboBox" prefWidth="150">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Todos"/>
                    <String fx:value="Doador"/>
                    <String fx:value="Instituição"/>
                </FXCollections>
            </items>
        </ComboBox>
        <ComboBox fx:id="filterValueComboBox" prefWidth="250" disable="true"/>
    </HBox>

    <TableView fx:id="doacaoListTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idListColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="doadorListColumn" text="Doador" prefWidth="150"/>
            <TableColumn fx:id="entidadeListColumn" text="Instituição" prefWidth="150"/>
            <TableColumn fx:id="itemListColumn" text="Item" prefWidth="150"/>
            <TableColumn fx:id="quantityListColumn" text="Quantidade" prefWidth="100"/>
            <TableColumn fx:id="dateListColumn" text="Data" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>